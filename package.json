{
  "name": "dsh-lumea",
  "version": "0.57.0",
  "description": "Lumea для DeepSeek Harness: MCP-сервер, скиллы и предохранители перед отправкой клиентам",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./hooks.json": "./plugins/lumea/hooks/hooks.json"
