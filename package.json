    "plugins/lumea/skills/",
    "plugins/lumea/locale/",
    "plugins/lumea/README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-hook-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugins/lumea/cordis.patch.yml"
    }
